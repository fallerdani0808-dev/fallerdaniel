    def rezept_finder(self, kategorie, zeit):
        passende = [r for r in self.rezepte if r.kategorie == kategorie and r.zeit == zeit]
        if passende:
            return random.choice(passende)
        return None
    

class RezeptApp:
    def __init__(self, root):
        self.finder = RezeptFinder()
        self.root = root
        self.root.title("Rezept-Empfehlungssystem")
        self.root.geometry("500x680")
        self.root.config(bg="#f4f4f9")

        self.aktives_rezept = None

        # Titel
        title_label = tk.Label(
            root,
            text="🍳 Rezept-Empfehlungssystem",
            font=("Arial", 14, "bold"),
            bg="#f4f4f9",
            fg="#333333",
        )
        title_label.pack(pady=10)

        # 1. Kategorie-Auswahl
        frame_kat = tk.LabelFrame(
            root,
            text=" Was möchten Sie essen? ",
            font=("Arial", 10, "bold"),
            bg="#f4f4f9",
            padx=10,
            pady=5,
        )
        frame_kat.pack(fill="x", padx=20, pady=5)

        self.kat_var = tk.StringVar(value="fleisch")
        tk.Radiobutton(
            frame_kat,
            text="Fleisch",
            variable=self.kat_var,
            value="fleisch",
            bg="#f4f4f9",
            font=("Arial", 10),
        ).pack(anchor="w")
        tk.Radiobutton(
            frame_kat,
            text="Ohne Fleisch",
            variable=self.kat_var,
            value="ohne",
            bg="#f4f4f9",
            font=("Arial", 10),
        ).pack(anchor="w")

        # 2. Zeit-Auswahl
        frame_zeit = tk.LabelFrame(
            root,
            text=" Wie viel Zeit haben Sie? ",
            font=("Arial", 10, "bold"),
            bg="#f4f4f9",
            padx=10,
            pady=5,
        )
        frame_zeit.pack(fill="x", padx=20, pady=5)

        self.zeit_var = tk.StringVar(value="schnell")
        tk.Radiobutton(
            frame_zeit,
            text="Schnell",
            variable=self.zeit_var,
            value="schnell",
            bg="#f4f4f9",
            font=("Arial", 10),
        ).pack(anchor="w")
        tk.Radiobutton(
            frame_zeit,
            text="Zeit (mehr Zeit)",
            variable=self.zeit_var,
            value="zeit",
            bg="#f4f4f9",
            font=("Arial", 10),
        ).pack(anchor="w")

        # Such-Button
        search_btn = tk.Button(
            root,
            text="Rezept finden",
            command=self.rezept_suchen,
            font=("Arial", 11, "bold"),
            bg="#4CAF50",
            fg="white",
            padx=10,
            pady=5,
        )
        search_btn.pack(pady=10)

        # Textfeld für Ergebnisse
        self.result_text = tk.Text(
            root,
            height=10,
            width=55,
            font=("Arial", 9),
            wrap="word",
            bg="white",
            fg="#333333",
        )
        self.result_text.pack(padx=20, pady=5)
        self.result_text.config(state="disabled")

        # Feedback-Frame (Buttons: Gefällt mir / Anderes Rezept)
        frame_feedback = tk.Frame(root, bg="#f4f4f9")
        frame_feedback.pack(pady=5)

        self.btn_like = tk.Button(
            frame_feedback,
            text="👍 Gefällt mir (Rezept anzeigen)",
            command=self.rezept_akzeptiert,
            font=("Arial", 9, "bold"),
            bg="#2196F3",
            fg="white",
            state="disabled"
        )
        self.btn_like.pack(side="left", padx=5)

        self.btn_dislike = tk.Button(
            frame_feedback,
            text="👎 Anderes Rezept",
            command=self.rezept_ablehnen,
            font=("Arial", 9, "bold"),
            bg="#FF9800",
            fg="white",
            state="disabled"
        )
        self.btn_dislike.pack(side="left", padx=5)

    def rezept_suchen(self):
        kat = self.kat_var.get()
        zeit = self.zeit_var.get()
        self.aktives_rezept = self.finder.rezept_finder(kat, zeit)
        
        self.result_text.config(state="normal")
        self.result_text.delete("1.0", tk.END)

        if self.aktives_rezept:
            output = (
                f"Vorschlag:\n"
                f"📌 {self.aktives_rezept.name}\n\n"
                f"Beschreibung: {self.aktives_rezept.kurzbeschreibung}\n\n"
                "Gefällt Ihnen diese Idee?"
            )
            self.result_text.insert(tk.END, output)
            self.btn_like.config(state="normal")
            self.btn_dislike.config(state="normal")
        else:
            self.result_text.insert(
                tk.END,
                "Leider kein passendes Rezept gefunden. Bitte überprüfen Sie Ihre Eingabe."
            )
            self.btn_like.config(state="disabled")
            self.btn_dislike.config(state="disabled")

        self.result_text.config(state="disabled")

    def rezept_akzeptiert(self):
        if self.aktives_rezept:
            self.result_text.config(state="normal")
            output = (
                f"✅ Ausgewähltes Rezept: {self.aktives_rezept.name}\n"
                f"Beschreibung: {self.aktives_rezept.kurzbeschreibung}\n\n"
                "------------------------------------------\n"
                f"VOLLSTÄNDIGES REZEPT:\n{self.aktives_rezept.rezept_text}\n"
                "------------------------------------------\n"
                "Guten Appetit!"
            )
            self.result_text.delete("1.0", tk.END)
            self.result_text.insert(tk.END, output)
            self.result_text.config(state="disabled")

    def rezept_ablehnen(self):
        self.rezept_suchen()


if __name__ == "__main__":
    root = tk.Tk()
    app = RezeptApp(root)
    root.mainloop()
