import random
import tkinter as tk

class Rezept:
    def __init__(self, name, kategorie, zeit, kurzbeschreibung, rezept_text):
        self.name = name
        self.kategorie = kategorie  # 'fleisch' oder 'ohne'
        self.zeit = zeit            # 'schnell' oder 'zeit'
        self.kurzbeschreibung = kurzbeschreibung
        self.rezept_text = rezept_text


